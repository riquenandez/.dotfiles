#!/usr/bin/env zsh

# This script checks if the STOW_FOLDERS environment variable is set. 
# If not, it sets STOW_FOLDERS to a list of folders: bash, bin, herdr, tmux, etc.
if [[ -z $STOW_FOLDERS ]]; then
    STOW_FOLDERS="bash, bin, herdr, nvim, tmux, yabai, zsh"
fi


# It then checks if the DOTFILES environment variable is set. 
# If not, it sets DOTFILES to the path ~/.dotfiles.
if [[ -z $DOTFILES ]]; then
    DOTFILES=$HOME/.dotfiles
fi

# Finally, it runs the stow command to symlink the contents of the specified 
# STOW_FOLDERS from the DOTFILES directory into the home directory (~).
STOW_FOLDERS=$STOW_FOLDERS DOTFILES=$DOTFILES $DOTFILES/install





